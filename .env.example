# OrderHub configuration. Copy to .env and edit.

# Network
# Default is loopback; Tailscale Serve proxies to it.
# Only use 0.0.0.0 when you explicitly want LAN/Tailscale IP access, with a token set.
ORDERHUB_HOST=127.0.0.1
ORDERHUB_PORT=8000

# Required if the app is reachable from other devices (iPhone / Tailscale).
# Generate a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ORDERHUB_TOKEN=change-me-to-a-long-random-token

# Data
# Windows example: ORDERHUB_DATA_DIR=C:\OrderHub\data
ORDERHUB_DATA_DIR=./data

# Kuaidi100 (optional, for parcel tracking)
# https://api.kuaidi100.com/
KUAIDI100_CUSTOMER=
KUAIDI100_KEY=
# Optional: last 4 digits of the recipient phone, required by some encrypted waybills.
KUAIDI100_PHONE=

# Bark push (optional, iOS)
# Example: https://api.day.app/your-bark-key
BARK_URL=

# Scheduler
ENABLE_SCHEDULER=1
PARCEL_POLL_SECONDS=1800

# JD collector (optional, requires Playwright + logged-in Chrome)
ENABLE_JD_COLLECTOR=0
JD_CDP_URL=http://127.0.0.1:9333
JD_ORDER_URL=https://order.jd.com/center/list.action
JD_INTERVAL_SECONDS=21600
JD_MAX_PAGES=50
JD_MAX_SCROLLS=8

# Optional: restrict upload size (bytes)
ORDERHUB_MAX_BODY=2097152
