# /etc/orderhub.env  (root:orderhub 0640)
ORDERHUB_HOST=0.0.0.0
ORDERHUB_PORT=8000
ORDERHUB_DATA_DIR=/var/lib/orderhub

# API clients: Windows collector agent + iPhone Shortcuts
ORDERHUB_TOKEN=change-me
ORDERHUB_COLLECTOR_TOKEN=change-me-too

# Browser login
ORDERHUB_PASSWORD_HASH=scrypt$...
ORDERHUB_SESSION_SECRET=change-me
ORDERHUB_COOKIE_SECURE=1
ORDERHUB_SESSION_TTL=2592000
ORDERHUB_LOGIN_RATE_LIMIT=8
ORDERHUB_LOGIN_RATE_WINDOW=900

# Server does not run JD Chrome/Playwright; the Windows agent does.
ENABLE_SCHEDULER=1
ENABLE_JD_COLLECTOR=0
PARCEL_POLL_SECONDS=1800

# Large full-history uploads from the agent (compressed)
ORDERHUB_MAX_BODY=16777216

# Optional
KUAIDI100_CUSTOMER=
KUAIDI100_KEY=
KUAIDI100_PHONE=
